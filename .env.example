# ── ptb-mn Lokale Entwicklungsumgebung ──────────────────────────────────────
# Lokale PostgreSQL (ptb-mn-db Container oder direkt installiert)
DATABASE_URL=postgresql://ptb_user:ptb_password@localhost:5432/ptb_mn

# Neon.tech (Produktion / Quelle)
# DATABASE_URL=postgresql://mn_owner:CBylvJA4OVg1@ep-dry-river-a2r3ntij-pooler.eu-central-1.aws.neon.tech/mn?sslmode=require

# DeepL API (für Übersetzungen im Bot)
DEEPL_API_KEY=d717cd13-e042-9301-0cb1-7afb29749bee:fx

# Telegram Bot Token
TELEGRAM=<DEIN_BOT_TOKEN>

# Kanal-IDs
CHANNEL_MEME=<CHANNEL_ID>
CHANNEL_SOURCE=<CHANNEL_ID>
CHANNEL_BACKUP=<CHANNEL_ID>
CHANNEL_SUGGEST=<CHANNEL_ID>

# Optional
CONTAINER=false
TESTING=false

# Local Ollama server used as a last-resort translation fallback, after
# Google Translate and the offline Argos Translate fallback both fail.
# Defaults match the "ollama" quadlet container on the pgnet network.
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
